{
  "name": "folio-md",
  "productName": "Folio",
  "version": "0.2.0",
  "license": "MIT",
  "author": "Carlos Rivera <me@carlosrivera.im>",
  "description": "A Markdown document editor with paginated preview, PDF export, and Model Context Protocol agent support.",
  "homepage": "https://carlosrivera.github.io/folio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosrivera/folio.git"
  },
  "bugs": {
    "url": "https://github.com/carlosrivera/folio/issues"
  },
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "main": "dist-electron/main.js",
  "bin": {
    "folio": "bin/folio.js"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm build:electron && concurrently -k \"vite\" \"pnpm:dev:electron\"",
    "mcp": "tsx src/mcp/server.ts",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "icons": "python3 scripts/generate-icons.py",
    "patch:electron": "node scripts/patch-electron-app.cjs",
    "postinstall": "node scripts/patch-electron-app.cjs",
    "build": "tsc -b && vite build && pnpm build:electron",
    "build:electron": "vite build --config vite.electron.config.ts && cp electron/preload.cjs dist-electron/preload.cjs && node scripts/patch-electron-app.cjs",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "dist:dir": "pnpm build && electron-builder --dir",
    "landing:dev": "pnpm --filter folio-landing dev",
    "landing:build": "pnpm --filter folio-landing build",
    "landing:preview": "pnpm --filter folio-landing preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b --pretty false && vitest run && pnpm test:render && pnpm test:editor",
    "test:editor": "electron tests/editor/run.cjs",
    "test:render": "pnpm build && electron tests/render/run.cjs",
    "test:render:update": "pnpm build && cross-env UPDATE_GOLDEN=1 electron tests/render/run.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-updater": "^6.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.2",
    "@lezer/highlight": "^1.2.3",
    "@mdit/plugin-katex": "^0.25.2",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@uiw/react-codemirror": "^4.25.1",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.15.3",
    "katex": "^0.16.47",
    "lucide-react": "^0.544.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^12.0.0",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4",
    "yaml": "^2.8.1"
  }
}
