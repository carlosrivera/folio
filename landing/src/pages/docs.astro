      </div>
    </div>
  </header>

  <!-- Docs Layout Container -->
  <div class="container docs-container">
    <!-- Sidebar Navigation -->
    <aside class="docs-sidebar">
      <nav class="sidebar-nav">
        <div class="sidebar-group">
          <p class="sidebar-title">Getting Started</p>
          <a href="#getting-started" class="sidebar-link">Overview & Installation</a>
          <a href="#editor-tour" class="sidebar-link">Editor Interface & Shortcuts</a>
        </div>

        <div class="sidebar-group">
          <p class="sidebar-title">Front Matter</p>
          <a href="#frontmatter" class="sidebar-link">Layouts & Metadata</a>
          <a href="#layout-report" class="sidebar-link">Cover Report (SOW)</a>
          <a href="#layout-invoice" class="sidebar-link">Invoices</a>
          <a href="#layout-simple" class="sidebar-link">Simple & Headers/Footers</a>
