---
import Layout from '../layouts/Layout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const githubRepo = 'https://github.com/carlosrivera/folio'
const releasesUrl = `${githubRepo}/releases`
const version = '0.2.0'
const downloadSilicon = `${releasesUrl}/download/v${version}/Folio-${version}-arm64.dmg`
const downloadIntel = `${releasesUrl}/download/v${version}/Folio-${version}.dmg`
---

<Layout title="Documentation — Folio" description="Complete documentation for Folio: Getting Started, Front Matter, Themes, MCP Server, and Development.">
  <!-- Top Navigation -->
  <header class="nav-wrap">
    <div class="container nav-inner">
      <a href={`${base}/`} class="brand" aria-label="Folio home">
