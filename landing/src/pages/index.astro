---
import Layout from '../layouts/Layout.astro'
import katex from 'katex'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const githubRepo = 'https://github.com/carlosrivera/folio'
const version = '0.1.0'
const downloadSilicon = `https://github.com/carlosrivera/folio/releases/download/v${version}/Folio-${version}-arm64.dmg`
const downloadIntel = `https://github.com/carlosrivera/folio/releases/download/v${version}/Folio-${version}.dmg`
const downloadSiliconZip = `https://github.com/carlosrivera/folio/releases/download/v${version}/Folio-${version}-arm64-mac.zip`
const downloadIntelZip = `https://github.com/carlosrivera/folio/releases/download/v${version}/Folio-${version}-mac.zip`

// Pre-render KaTeX equations for the preview document at build time
const eqLyapunov = katex.renderToString('V(x) = \\frac{1}{2} x^T P x + \\int_0^t \\gamma \\|u(\\tau)\\|^2 d\\tau', { displayMode: true, throwOnError: false })
const eqRiccati = katex.renderToString('A^T P + P A - P B R^{-1} B^T P + Q = 0', { displayMode: true, throwOnError: false })
const inlineP = katex.renderToString('P \\succ 0', { displayMode: false })
const inlineOmega = katex.renderToString('\\Omega \\subset \\mathbb{R}^n', { displayMode: false })

// Pre-render KaTeX showcase equation
const eqShowcase = katex.renderToString('\\mathcal{L}_{\\text{total}}(\\theta) = \\mathbb{E}_{x \\sim p_{\\text{data}}}\\left[ -\\log p_\\theta(x) \\right] + \\beta \\cdot D_{\\text{KL}}\\left( q_\\phi(z|x) \\,\\parallel\\, p(z) \\right)', { displayMode: true, throwOnError: false })

const themes = [
  { id: 'voltage', name: 'Voltage', swatch: '#d4ff2b', bg: '#000000', fonts: 'Space Grotesk · JetBrains Mono', desc: 'Pure pitch black, acid lime accents, sharp monospace details.' },
  { id: 'editorial', name: 'Editorial', swatch: '#e56c47', bg: '#172d29', fonts: 'Georgia Serif · Humanist Body', desc: 'Deep British racing green cover, terracotta rules, classical serif type.' },
  { id: 'slate', name: 'Slate', swatch: '#38bdf8', bg: '#0f172a', fonts: 'Inter · Executive Sans', desc: 'Midnight slate navy, electric sky blue accents, corporate engineering.' },
  { id: 'scientific', name: 'Scientific', swatch: '#47657a', bg: '#ffffff', fonts: 'Computer Modern · Academic Serif', desc: 'Paper white, formal steel navy, numbered sections, spacious equations.' },
  { id: 'contrast', name: 'Contrast', swatch: '#ffffff', bg: '#000000', fonts: 'Inter Display · Stark Mono', desc: 'Brutalist monochrome black & white, heavy rules, zero fluff.' },
  { id: 'graphite', name: 'Graphite', swatch: '#a3e635', bg: '#101113', fonts: 'Barlow · Swiss Grid', desc: 'Graphite charcoal, technical lime accents, engineer\'s drafting aesthetic.' },
  { id: 'nocturne', name: 'Nocturne', swatch: '#ff79c6', bg: '#282a36', fonts: 'Space Grotesk · Cyber Mono', desc: 'Deep plum cover, cyberpunk violet & neon pink accents.' },
]
---

<Layout>
  <!-- Navigation -->
  <header class="nav-wrap">
    <div class="container nav-inner">
      <a href={`${base}/`} class="brand" aria-label="Folio home">
        <span class="brand-badge">F/</span>
        <span class="brand-text">folio.</span>
      </a>

      <nav class="nav-links">
        <a href="#themes">Themes</a>
        <a href="#latex">LaTeX Math</a>
        <a href="#engine">Print Engine</a>
        <a href="#faq">FAQ</a>
      </nav>

      <div class="nav-actions">
        <a href={githubRepo} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="GitHub Repository">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a href={downloadSilicon} class="btn-pill" id="nav-dl-btn" download>Download .dmg →</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container hero-content">
        <p class="eyebrow">macOS Native Markdown Publisher</p>
        <h1>Plain Markdown.<br>Boardroom-ready pages.</h1>
        <p class="hero-lede">
          Folio turns plain text Markdown into print-shop quality PDFs with real-time A4 pagination, cover sheets, LaTeX math, and zero cloud lock-in. Built for documents destined for paper.
        </p>

        <div class="hero-cta-wrap">
          <div class="split-cta-container">
            <a href={downloadSilicon} class="cta-pill-main" id="hero-dl-btn" download>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download for macOS</span>
              <span class="cta-arch-badge" id="hero-arch-badge">Apple Silicon</span>
            </a>
            <button type="button" class="cta-dropdown-btn" id="hero-dl-toggle" aria-expanded="false" aria-label="Select Architecture">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>

            <!-- Architecture Dropdown Menu -->
            <div class="cta-dropdown-menu" id="hero-dl-menu" role="menu">
              <a href={downloadSilicon} class="menu-item is-selected" id="opt-silicon" role="menuitem" download>
                <div class="menu-item-info">
                  <div class="menu-item-title">
                    <strong>Apple Silicon</strong>
                    <span class="rec-badge">Default</span>
                  </div>
                  <span class="menu-item-desc">M1, M2, M3, M4 Macs · .dmg (99 MB)</span>
                </div>
                <span class="check-mark">✓</span>
              </a>
              <a href={downloadIntel} class="menu-item" id="opt-intel" role="menuitem" download>
                <div class="menu-item-info">
                  <div class="menu-item-title">
                    <strong>Intel Mac</strong>
                  </div>
                  <span class="menu-item-desc">x86_64 architecture · .dmg (106 MB)</span>
                </div>
              </a>
              <div class="menu-divider"></div>
              <div class="menu-sub-row">
                <a href={downloadSiliconZip} class="sub-link" download>Silicon .zip</a>
                <span class="sub-dot">·</span>
                <a href={downloadIntelZip} class="sub-link" download>Intel .zip</a>
                <span class="sub-dot">·</span>
                <a href="https://github.com/carlosrivera/folio/releases/tag/v0.1.0" target="_blank" rel="noopener noreferrer" class="sub-link">All releases ↗</a>
              </div>
            </div>
          </div>
          <p class="cta-meta" id="cta-meta-text">Direct .dmg download · Apple Silicon (M-series) · macOS 12+</p>
        </div>
      </div>

      <!-- App Window Mockup: Desktop layout, fixed proportions, never squashed -->
      <div class="container window-container">
        <div class="app-window" id="app-window">
          <!-- macOS Native Titlebar -->
          <div class="app-titlebar">
            <div class="titlebar-left">
              <div class="traffic-lights" aria-hidden="true">
                <span class="tl-close"></span>
                <span class="tl-min"></span>
                <span class="tl-max"></span>
              </div>
              <div class="app-brand-mark">
                <span class="app-icon-squircle">F/</span>
                <span class="app-window-name">Folio</span>
              </div>
              <div class="doc-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                <span>specification.md</span>
              </div>
            </div>

            <!-- Toolbar Pills -->
            <div class="titlebar-center">
              <div class="pill-select" title="Document Layout">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg>
                <span>Spec</span>
                <span class="arrow">⌵</span>
              </div>
              
              <!-- Dynamic Theme Selector Pill with Dropdown -->
              <div class="pill-select is-theme" id="app-theme-pill" title="Select Theme" tabindex="0">
                <span class="swatch-square" id="app-theme-swatch" style="background: #d4ff2b;"></span>
                <span id="app-theme-name">Voltage</span>
                <span class="arrow">⌵</span>

                <!-- Titlebar Theme Dropdown Popover -->
                <div class="titlebar-theme-menu" id="titlebar-theme-menu" role="menu">
                  {themes.map((t) => (
                    <div class="titlebar-theme-item" data-theme-id={t.id} data-theme-name={t.name} data-theme-swatch={t.swatch} role="menuitem">
                      <span class="swatch-square" style={`background: ${t.swatch};`}></span>
                      <span>{t.name}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="pill-select" title="Language">
                <span>EN</span>
                <span class="arrow">⌵</span>
              </div>
            </div>

            <div class="titlebar-right">
              <div class="theme-icon-toggle">
                <span>🖥</span><span>☼</span><span>☾</span>
              </div>
              <button class="win-btn win-btn-subtle">+ New</button>
              <button class="win-btn win-btn-subtle">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                Open
              </button>
              <button class="win-btn win-btn-subtle">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Save
              </button>
              <button class="win-btn win-btn-export">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                Export PDF
              </button>
            </div>
          </div>

          <!-- Subtoolbars Row -->
          <div class="app-subbars">
            <div class="editor-subbar">
              <div class="subbar-left-group">
                <div class="subbar-label">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                  <span>Markdown</span>
                </div>
                <div class="editor-formatting-tools">
                  <span>H2</span>
                  <span>B</span>
                  <span>I</span>
                  <span>Link</span>
                  <span>List</span>
                  <span>Quote</span>
                  <span>Code</span>
                  <span>Table</span>
                </div>
              </div>
              <div class="editor-tools-right">
                <span class="active-badge">123</span>
                <span>Fold</span>
                <span class="badge-issues">✓ No issues</span>
              </div>
            </div>

            <div class="preview-subbar">
              <div class="subbar-label">
                <span>Preview</span>
              </div>
              <div class="preview-page-controls">
                <button class="pg-arrow" id="btn-prev-page" title="Previous page">‹</button>
                <span class="pg-status" id="pg-status-num">2 / 4</span>
                <button class="pg-arrow" id="btn-next-page" title="Next page">›</button>
                <div class="page-view-tabs">
                  <button class="view-tab" id="tab-cover-view">Cover</button>
                  <button class="view-tab is-active" id="tab-body-view">Page 2: Math & Spec</button>
                </div>
              </div>
              <div class="preview-status-right">
                <span class="zoom-level">100%</span>
                <span class="preview-meta" id="preview-meta-badge">Voltage</span>
              </div>
            </div>
          </div>

          <!-- Main App Split: CodeMirror Editor (Left) & Rendered Document Sheet (Right) -->
          <div class="app-body">
            <!-- Left: CodeMirror Editor -->
            <div class="editor-pane">
              <div class="cm-gutter">
                <div class="cm-line-numbers">
                  <div>1</div><div>2</div><div>3</div><div>4</div><div>5</div>
                  <div>6</div><div>7</div><div>8</div><div>9</div><div>10</div>
                  <div>11</div><div>12</div><div>13</div><div>14</div><div>15</div>
                  <div>16</div><div>17</div><div>18</div><div>19</div><div>20</div>
                  <div>21</div><div>22</div><div>23</div><div>24</div><div>25</div>
                  <div>26</div>
                </div>
              </div>
              <div class="cm-content">
                <div class="cm-line"><span class="tok-hr">---</span></div>
                <div class="cm-line"><span class="tok-prop">layout</span>: <span class="tok-string">document</span></div>
                <div class="cm-line"><span class="tok-prop">theme</span>: <span class="tok-string" id="cm-theme-code">voltage</span></div>
                <div class="cm-line"><span class="tok-prop">title</span>: <span class="tok-string">Autonomous Systems Specification</span></div>
                <div class="cm-line"><span class="tok-prop">client</span>: <span class="tok-string">Apex Robotics Lab</span></div>
                <div class="cm-line"><span class="tok-prop">document-id</span>: <span class="tok-string">SPEC-2026-09</span></div>
                <div class="cm-line"><span class="tok-prop">lang</span>: <span class="tok-string">en</span></div>
                <div class="cm-line"><span class="tok-hr">---</span></div>
                <div class="cm-line">&nbsp;</div>
                <div class="cm-line"><span class="tok-h2">## 2. Deterministic State Estimation</span></div>
                <div class="cm-line">&nbsp;</div>
                <div class="cm-line"><span class="tok-text">Core control loop executes deterministic state estimation over 200 Hz boundary:</span></div>
                <div class="cm-line">&nbsp;</div>
                <div class="cm-line"><span class="tok-math">$$V(x) = \frac&#123;1&#125;&#123;2&#125; x^T P x + \int_0^t \gamma \|u(\tau)\|^2 d\tau$$</span></div>
                <div class="cm-line">&nbsp;</div>
                <div class="cm-line"><span class="tok-text">Where </span><span class="tok-math">$P \succ 0$</span><span class="tok-text"> satisfies continuous-time Riccati bounds:</span></div>
                <div class="cm-line">&nbsp;</div>
                <div class="cm-line"><span class="tok-math">$$A^T P + P A - P B R^&#123;-1&#125; B^T P + Q = 0$$</span></div>
                <div class="cm-line">&nbsp;</div>
                <div class="cm-line"><span class="tok-quote">&gt; "Deterministic convergence guaranteed within 14 ms for perturbations."</span></div>
                <div class="cm-line">&nbsp;</div>
                <div class="cm-line"><span class="tok-h3">### Milestone Deliverables</span></div>
                <div class="cm-line">&nbsp;</div>
                <div class="cm-line"><span class="tok-table">| Module | Latency | Determinism | SLA |</span></div>
                <div class="cm-line"><span class="tok-table">| :--- | ---: | :--- | ---: |</span></div>
                <div class="cm-line"><span class="tok-table">| EKF Estimator | &lt; 2.4 ms | Hard Real-Time | 99.99% |</span></div>
              </div>
              <div class="editor-bottom-bar">
                <span class="tab is-active">Issues (0)</span>
                <span class="tab">Changes</span>
                <span class="tab">Template</span>
                <span class="editor-meta">UTF-8 · LF · Markdown</span>
              </div>
            </div>

            <!-- Right: Rendered Document Sheet (True Print A4 Physics) -->
            <div class="preview-stage" id="preview-stage">
              <!-- PAGE 2 VIEW: CONTENT SHEET WITH LATEX MATH & DELIVERABLES -->
              <div class="doc-page-sheet theme-voltage" id="active-body-page">
                <!-- Running Header -->
                <div class="sheet-running-header">
                  <span class="hdr-left">FOLIO / APEX ROBOTICS</span>
                  <span class="hdr-center">§ 2.4 STATE ESTIMATION & BOUNDS</span>
                  <span class="hdr-right">SPEC-2026-09</span>
                </div>

                <div class="sheet-body-content">
                  <h2 class="sheet-h2">2. Deterministic State Estimation</h2>
                  <p class="sheet-lead">
                    The core trajectory planner executes deterministic state estimation over a 200 Hz boundary. System stability is proven through the Lyapunov function <span class="sheet-math-inline" set:html={inlineP} />:
                  </p>

                  <!-- Real LaTeX Display Equation 1 -->
                  <div class="sheet-equation-card">
                    <div class="sheet-equation-math" set:html={eqLyapunov} />
                    <span class="sheet-eq-num">(2.1)</span>
                  </div>

                  <p class="sheet-p">
                    Where the algebraic Riccati matrix satisfies positive definiteness for all disturbances bounded by <span class="sheet-math-inline" set:html={inlineOmega} />:
                  </p>

                  <!-- Real LaTeX Display Equation 2 -->
                  <div class="sheet-equation-card">
                    <div class="sheet-equation-math" set:html={eqRiccati} />
                    <span class="sheet-eq-num">(2.2)</span>
                  </div>

                  <!-- Themed Blockquote -->
                  <blockquote class="sheet-blockquote">
                    <p>"Deterministic convergence is mathematically guaranteed within 14 ms for all initial state perturbations bounded by the stability envelope."</p>
                  </blockquote>

                  <!-- Milestone Deliverables Table -->
                  <div class="sheet-table-section">
                    <div class="sheet-table-kicker">// MILESTONE DELIVERABLES & LATENCY BUDGET</div>
                    <table class="sheet-table">
                      <thead>
                        <tr>
                          <th>Module</th>
                          <th>Latency</th>
                          <th>Determinism</th>
                          <th>Target SLA</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td><strong>State Estimator</strong></td>
                          <td>&lt; 2.4 ms</td>
                          <td>Hard Real-Time</td>
                          <td>99.99%</td>
                        </tr>
                        <tr>
                          <td><strong>Trajectory QP</strong></td>
                          <td>&lt; 8.1 ms</td>
                          <td>Bounded Loop</td>
                          <td>99.95%</td>
                        </tr>
                        <tr>
                          <td><strong>CAN Bus Link</strong></td>
                          <td>&lt; 0.8 ms</td>
                          <td>Deterministic</td>
                          <td>99.99%</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>

                <!-- Running Footer -->
                <div class="sheet-running-footer">
                  <span class="ftr-left">Confidential · Apex Robotics Lab</span>
                  <span class="ftr-right">Page 2 of 4</span>
                </div>
              </div>

              <!-- PAGE 1 VIEW: THEMED COVER SHEET (TOGGLEABLE) -->
              <div class="doc-cover-sheet theme-voltage" id="active-cover-page" style="display: none;">
                <div class="cover-kicker-line">TECHNICAL SPECIFICATION · SPEC-2026-09</div>
                <h1 class="cover-title">Autonomous Systems Specification</h1>
                <p class="cover-client-line">Prepared for Apex Robotics Lab · Autonomous Fleet Division</p>
                <div class="cover-rule-divider"></div>
                
                <div class="cover-grid-details">
                  <div class="cov-col">
                    <span class="cov-lbl">Prepared For</span>
                    <strong class="cov-val">Apex Robotics Lab</strong>
                  </div>
                  <div class="cov-col">
                    <span class="cov-lbl">Prepared By</span>
                    <strong class="cov-val">Folio Engineering</strong>
                  </div>
                  <div class="cov-col">
                    <span class="cov-lbl">Issued</span>
                    <strong class="cov-val">October 2026</strong>
                  </div>
                  <div class="cov-col">
                    <span class="cov-lbl">Valid Until</span>
                    <strong class="cov-val">Q4 2027</strong>
                  </div>
                </div>

                <!-- Geometric Accent Art -->
                <div class="cover-accent-rings">
                  <span class="ring-1"></span>
                  <span class="ring-2"></span>
                  <span class="ring-3"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Theme Showcase: 7 Curated Themes -->
    <section class="section themes-section" id="themes">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Typography & Print Palettes</p>
          <h2 class="section-title">Seven curated themes. Zero styling fatigue.</h2>
          <p class="section-desc">
            Click any theme below to transform the document and entire site palette in real time. Every theme brings calibrated display typography, line heights, running headers, table rules, and print palettes:
          </p>
        </div>

        <div class="themes-split-layout">
          <!-- Left: Theme Selector Cards -->
          <div class="themes-selector-pane">
            <div class="theme-grid">
              {themes.map((t, idx) => (
                <button 
                  type="button" 
                  class={`theme-card ${idx === 0 ? 'is-active' : ''}`} 
                  data-theme-id={t.id}
                  data-theme-name={t.name}
                  data-theme-swatch={t.swatch}
                  data-theme-bg={t.bg}
                >
                  <div class="theme-card-head">
                    <span class="theme-swatch-chip" style={`background: ${t.swatch}; border-color: ${t.id === 'contrast' || t.id === 'scientific' ? '#ccc' : 'transparent'};`}></span>
                    <strong class="theme-name">{t.name}</strong>
                    <span class="theme-check-radio">✓</span>
                  </div>
                  <div class="theme-fonts">{t.fonts}</div>
                  <p class="theme-desc">{t.desc}</p>
                </button>
              ))}
            </div>

            <div class="themes-reset-row">
              <span class="theme-status-text">Active Theme: <strong id="active-theme-label">Voltage</strong></span>
              <button type="button" class="btn-reset-theme" id="btn-reset-cream">Reset page to warm cream ↺</button>
            </div>
          </div>

          <!-- Right: Live Synchronized Document Sheet Viewport -->
          <div class="themes-preview-pane">
            <div class="themes-preview-container">
              <div class="themes-preview-header">
                <div class="preview-doc-meta">
                  <span class="doc-file-tag">specification.md</span>
                  <span class="preview-theme-tag" id="themes-preview-tag">Voltage</span>
                </div>
                <div class="preview-tab-pills">
                  <button type="button" class="tab-pill" id="themes-tab-cover">Cover Sheet</button>
