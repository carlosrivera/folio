<script>
  // Interactive Theme Switching Logic
  const themeCards = document.querySelectorAll<HTMLButtonElement>('.theme-card')
  const cmThemeCode = document.getElementById('cm-theme-code')
  const appThemeName = document.getElementById('app-theme-name')
  const appThemeSwatch = document.getElementById('app-theme-swatch')
  const activeBodyPage = document.getElementById('active-body-page')
  const activeCoverPage = document.getElementById('active-cover-page')
  const previewMetaBadge = document.getElementById('preview-meta-badge')

  // Hero Page View Switching Logic (Cover vs Body Page)
  const tabCoverView = document.getElementById('tab-cover-view')
  const tabBodyView = document.getElementById('tab-body-view')
  const btnPrevPage = document.getElementById('btn-prev-page')
  const btnNextPage = document.getElementById('btn-next-page')
  const pgStatusNum = document.getElementById('pg-status-num')

  // Themes Section Synchronized Sheet
  const themesBodySheet = document.getElementById('themes-body-sheet')
  const themesCoverSheet = document.getElementById('themes-cover-sheet')
  const themesTabCover = document.getElementById('themes-tab-cover')
  const themesTabBody = document.getElementById('themes-tab-body')
  const activeThemeLabel = document.getElementById('active-theme-label')
  const themesPreviewTag = document.getElementById('themes-preview-tag')
  const btnResetCream = document.getElementById('btn-reset-cream')

  // Hero Titlebar Theme Dropdown
  const appThemePill = document.getElementById('app-theme-pill')
  const titlebarThemeMenu = document.getElementById('titlebar-theme-menu')
  const titlebarItems = document.querySelectorAll<HTMLElement>('.titlebar-theme-item')

  let currentTheme = 'voltage'
  let currentThemeName = 'Voltage'
  let currentThemeSwatch = '#d4ff2b'
  let currentHeroPage = 2 // 1 = Cover, 2 = Body/Spec
  let currentThemesSecPage = 2 // 1 = Cover, 2 = Body/Spec

  function updateHeroView(page: number) {
    currentHeroPage = page
    if (page === 1) {
      if (activeCoverPage) activeCoverPage.style.display = 'flex'
      if (activeBodyPage) activeBodyPage.style.display = 'none'
      if (tabCoverView) tabCoverView.classList.add('is-active')
      if (tabBodyView) tabBodyView.classList.remove('is-active')
      if (pgStatusNum) pgStatusNum.textContent = '1 / 4'
      if (previewMetaBadge) previewMetaBadge.textContent = `SPEC · ${currentThemeName} · Cover`
    } else {
      if (activeCoverPage) activeCoverPage.style.display = 'none'
      if (activeBodyPage) activeBodyPage.style.display = 'flex'
      if (tabCoverView) tabCoverView.classList.remove('is-active')
      if (tabBodyView) tabBodyView.classList.add('is-active')
      if (pgStatusNum) pgStatusNum.textContent = '2 / 4'
      if (previewMetaBadge) previewMetaBadge.textContent = `SPEC · ${currentThemeName} · Page 2 of 4`
    }
  }

  function updateThemesSecView(page: number) {
    currentThemesSecPage = page
    if (page === 1) {
      if (themesCoverSheet) themesCoverSheet.style.display = 'flex'
      if (themesBodySheet) themesBodySheet.style.display = 'none'
      if (themesTabCover) themesTabCover.classList.add('is-active')
      if (themesTabBody) themesTabBody.classList.remove('is-active')
    } else {
      if (themesCoverSheet) themesCoverSheet.style.display = 'none'
      if (themesBodySheet) themesBodySheet.style.display = 'flex'
      if (themesTabCover) themesTabCover.classList.remove('is-active')
      if (themesTabBody) themesTabBody.classList.add('is-active')
    }
  }

  function applyTheme(themeId: string, themeName: string, themeSwatch: string, updatePageTheme = true) {
    currentTheme = themeId
    currentThemeName = themeName
    currentThemeSwatch = themeSwatch

    // 1. Update the entire site palette by setting data-theme on html
    if (updatePageTheme) {
      document.documentElement.setAttribute('data-theme', themeId)
    }

    // 2. Update active state on cards
    themeCards.forEach((c) => {
      c.classList.toggle('is-active', c.getAttribute('data-theme-id') === themeId)
    })

    // 3. Update CodeMirror frontmatter token
    if (cmThemeCode) cmThemeCode.textContent = themeId

    // 4. Update macOS app titlebar pill in hero
    if (appThemeName) appThemeName.textContent = themeName
    if (appThemeSwatch) (appThemeSwatch as HTMLElement).style.background = themeSwatch

    // 5. Update labels & badges
    if (activeThemeLabel) activeThemeLabel.textContent = themeName
    if (themesPreviewTag) themesPreviewTag.textContent = themeName

    // 6. Update sheet classes on all preview sheets
    const allThemeClasses = ['theme-voltage', 'theme-editorial', 'theme-slate', 'theme-scientific', 'theme-contrast', 'theme-graphite', 'theme-nocturne']
    
    const targets = [activeBodyPage, activeCoverPage, themesBodySheet, themesCoverSheet]
    targets.forEach((sheet) => {
      if (!sheet) return
      allThemeClasses.forEach((cls) => sheet.classList.remove(cls))
      sheet.classList.add(`theme-${themeId}`)
    })

    updateHeroView(currentHeroPage)
    updateThemesSecView(currentThemesSecPage)
  }

  // Click on theme cards in #themes
  themeCards.forEach((card) => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-theme-id') || 'voltage'
      const name = card.getAttribute('data-theme-name') || 'Voltage'
      const swatch = card.getAttribute('data-theme-swatch') || '#d4ff2b'
      applyTheme(id, name, swatch, true)
    })
  })

  // Hero Titlebar Pill dropdown toggle
  appThemePill?.addEventListener('click', (e) => {
    e.stopPropagation()
    titlebarThemeMenu?.classList.toggle('is-open')
  })

  titlebarItems.forEach((item) => {
    item.addEventListener('click', (e) => {
      e.stopPropagation()
      const id = item.getAttribute('data-theme-id') || 'voltage'
      const name = item.getAttribute('data-theme-name') || 'Voltage'
      const swatch = item.getAttribute('data-theme-swatch') || '#d4ff2b'
      applyTheme(id, name, swatch, true)
      titlebarThemeMenu?.classList.remove('is-open')
    })
  })

  // Reset page theme to warm cream
  btnResetCream?.addEventListener('click', () => {
    document.documentElement.removeAttribute('data-theme')
  })

  // Hero Page view tabs
  tabCoverView?.addEventListener('click', () => updateHeroView(1))
  tabBodyView?.addEventListener('click', () => updateHeroView(2))
  btnPrevPage?.addEventListener('click', () => updateHeroView(1))
  btnNextPage?.addEventListener('click', () => updateHeroView(2))

  // Themes Section View tabs
  themesTabCover?.addEventListener('click', () => updateThemesSecView(1))
  themesTabBody?.addEventListener('click', () => updateThemesSecView(2))

  // Architecture Dropdown Menus (Hero and Closing)
  function setupDropdown(toggleId: string, menuId: string) {
    const toggle = document.getElementById(toggleId)
    const menu = document.getElementById(menuId)
    if (!toggle || !menu) return

    function openMenu() {
      menu.classList.add('is-open')
      toggle?.setAttribute('aria-expanded', 'true')
    }

    function closeMenu() {
      menu.classList.remove('is-open')
      toggle?.setAttribute('aria-expanded', 'false')
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation()
      const isOpen = menu.classList.contains('is-open')
      document.querySelectorAll('.cta-dropdown-menu.is-open').forEach((m) => {
        if (m !== menu) m.classList.remove('is-open')
      })
      document.querySelectorAll('.cta-dropdown-btn[aria-expanded="true"]').forEach((b) => {
        if (b !== toggle) b.setAttribute('aria-expanded', 'false')
      })
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    })

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu()
      })
    })
  }

  setupDropdown('hero-dl-toggle', 'hero-dl-menu')
  setupDropdown('closing-dl-toggle', 'closing-dl-menu')

  // Close menus on outside click or Escape
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement
    if (!target.closest('.split-cta-container')) {
      document.querySelectorAll('.cta-dropdown-menu.is-open').forEach((m) => m.classList.remove('is-open'))
      document.querySelectorAll('.cta-dropdown-btn[aria-expanded="true"]').forEach((b) => b.setAttribute('aria-expanded', 'false'))
    }
    if (!target.closest('#app-theme-pill')) {
      titlebarThemeMenu?.classList.remove('is-open')
    }
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.cta-dropdown-menu.is-open').forEach((m) => m.classList.remove('is-open'))
      document.querySelectorAll('.cta-dropdown-btn[aria-expanded="true"]').forEach((b) => b.setAttribute('aria-expanded', 'false'))
      titlebarThemeMenu?.classList.remove('is-open')
    }
  })
</script>

