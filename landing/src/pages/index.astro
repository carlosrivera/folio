    width: 28px;
    height: 28px;
    background: var(--accent);
    color: var(--accent-fg, #fff);
    border-radius: 7px;
    font-size: 0.85rem;
    font-weight: 800;
    transition: background-color 0.4s ease, color 0.4s ease;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-2);
  }

  .nav-links a {
    transition: color 0.15s ease;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .icon-link {
    color: var(--text-2);
    display: flex;
    align-items: center;
    transition: color 0.15s ease;
  }

  .icon-link:hover {
    color: var(--text);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--surface);
    border-color: var(--text-2);
    color: var(--text);
    transform: translateY(-1px);
  }

  .btn-secondary svg {
    opacity: 0.65;
    transition: transform 0.2s var(--ease-out), opacity 0.2s ease;
  }

  .btn-secondary:hover svg {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  /* Responsive Mobile Navigation Toggle Button */
  .mobile-nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    gap: 4px;
    padding: 0;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .mobile-nav-toggle:hover {
    background: var(--surface);
    border-color: var(--text-2);
  }

  .hamburger-bar {
    display: block;
    width: 16px;
    height: 1.75px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .mobile-nav-toggle[aria-expanded="true"] .bar-1 {
    transform: translateY(5.75px) rotate(45deg);
  }

  .mobile-nav-toggle[aria-expanded="true"] .bar-2 {
    opacity: 0;
  }

  .mobile-nav-toggle[aria-expanded="true"] .bar-3 {
    transform: translateY(-5.75px) rotate(-45deg);
  }

  /* Mobile Navigation Dropdown Drawer */
  .mobile-nav-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .mobile-nav-menu.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-nav-inner {
    padding: 1.2rem var(--gutter) 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-links a {
    padding: 0.65rem 0.85rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .mobile-nav-links a:hover {
    background: var(--surface);
    color: var(--accent);
  }

  .mobile-nav-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .mobile-free-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-2);
  }

  .free-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--healthy);
  }

  @media (max-width: 840px) {
    .nav-links {
      display: none;
    }
    .mobile-nav-toggle {
      display: flex;
    }
    .mobile-nav-menu {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .nav-inner {
      height: 56px;
    }
    .nav-releases-btn {
      display: none;
    }
  }

  /* Hero Section */
  .hero {
    padding: 3.5rem 0 4.5rem;
    text-align: center;
  }

  .hero-content {
    position: relative;
    z-index: 30;
    max-width: 840px;
    margin: 0 auto 2.5rem;
  }

  .eyebrow {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.8rem;
  }

  /* Refined, more compact headers fitting in fewer lines */
  .hero h1 {
    font-size: clamp(2.1rem, 3.8vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 1.1rem;
  }

  .hero-lede {
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    color: var(--text-2);
    max-width: 680px;
    margin: 0 auto 1.8rem;
  }

  .hero-cta-wrap {
    position: relative;
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* Split CTA Container & Architecture Dropdown */
  .split-cta-container {
    position: relative;
    z-index: 40;
    display: inline-flex;
    align-items: stretch;
    border-radius: 999px;
    box-shadow: 0 4px 18px rgba(210, 92, 58, 0.28);
    transition: transform 0.2s var(--spring), box-shadow 0.2s ease;
  }

  .split-cta-container:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(210, 92, 58, 0.38);
  }

  .cta-pill-main {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 20px 13px 26px;
    background: var(--accent);
    color: var(--accent-fg, #ffffff);
    border-top-left-radius: 999px;
    border-bottom-left-radius: 999px;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .cta-pill-main:hover {
    background: var(--accent-hover);
  }

  .cta-arch-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(0, 0, 0, 0.16);
    color: inherit;
    border: 1px solid rgba(0, 0, 0, 0.12);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 3px 9px;
    border-radius: 999px;
  }

  .cta-dropdown-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    background: var(--accent);
    color: var(--accent-fg, #ffffff);
    border: none;
    border-left: 1px solid rgba(127, 127, 127, 0.32);
    border-top-right-radius: 999px;
    border-bottom-right-radius: 999px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .cta-dropdown-btn:hover,
  .cta-dropdown-btn[aria-expanded="true"] {
    background: var(--accent-hover);
  }

  .cta-dropdown-btn svg {
    transition: transform 0.2s var(--spring);
  }

  .cta-dropdown-btn[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  /* Dropdown Floating Menu */
  .cta-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    width: 320px;
    max-width: 90vw;
    background: var(--surface, #ffffff);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 8px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.32), 0 2px 6px rgba(0, 0, 0, 0.12);
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s var(--spring), background-color 0.4s ease, border-color 0.4s ease;
    text-align: left;
  }

  .cta-dropdown-menu.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .cta-dropdown-menu.dropdown-up {
    top: auto;
    bottom: calc(100% + 10px);
    transform: translateX(-50%) translateY(-6px);
  }

  .cta-dropdown-menu.dropdown-up.is-open {
    transform: translateX(-50%) translateY(0);
  }

  .menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    transition: background 0.15s ease;
  }

  .menu-item:hover {
    background: var(--accent-light, rgba(255, 255, 255, 0.08));
  }

  .menu-item.is-selected {
    background: var(--accent-light, rgba(210, 92, 58, 0.12));
  }

  .menu-item-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .menu-item-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--text);
  }

  .rec-badge {
    font-size: 0.65rem;
    background: var(--accent);
    color: var(--accent-fg, #ffffff);
    padding: 1px 6px;
    border-radius: 999px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .menu-item-desc {
    font-size: 0.78rem;
    color: var(--text-2);
  }

  .check-mark {
    color: var(--accent);
    font-weight: 800;
    font-size: 0.92rem;
  }

  .menu-divider {
    height: 1px;
    background: var(--border);
    margin: 6px 4px;
  }

  .menu-sub-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 6px 8px 4px;
    font-size: 0.78rem;
    color: var(--text-2);
  }

  .sub-link {
    color: var(--text-2);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .sub-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .sub-dot {
    color: var(--border);
  }

  .cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    background: var(--accent);
    color: var(--accent-fg, #ffffff);
    border-radius: 999px;
    font-size: 1.05rem;
    font-weight: 600;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s var(--spring), box-shadow 0.2s ease, background 0.15s ease, color 0.15s ease;
  }

  .cta-pill:hover {
    transform: translateY(-2px);
    background: var(--accent-hover);
    box-shadow: 0 6px 20px rgba(210, 92, 58, 0.38);
  }

  .cta-meta {
    font-size: 0.83rem;
    color: var(--text-faint);
  }

  .cta-free-badge {
    color: var(--healthy);
    font-weight: 600;
  }

  /* Window Container: Desktop-first, fixed desktop proportions */
  .window-container {
    position: relative;
    z-index: 1;
    max-width: 1220px;
    margin: 0 auto;
    overflow-x: auto;
    padding: 20px 40px 60px;
    scrollbar-width: thin;
  }

  .app-window {
    min-width: 980px;
    background: #141517;
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.35);
    box-shadow: 
      0 2px 6px rgba(0, 0, 0, 0.08),
      0 12px 28px -4px rgba(0, 0, 0, 0.14),
      0 24px 48px -10px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    color: #e4e4e7;
    text-align: left;
  }

  /* Titlebar */
  .app-titlebar {
    height: 44px;
    background: #1e2024;
    border-bottom: 1px solid #2b2e34;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    user-select: none;
  }

  .titlebar-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .traffic-lights {
    display: flex;
    gap: 7px;
  }

  .traffic-lights span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .tl-close { background: #ff5f56; border: 1px solid #e0443e; }
  .tl-min { background: #ffbd2e; border: 1px solid #dea123; }
  .tl-max { background: #27c93f; border: 1px solid #1aab29; }

  .app-brand-mark {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .app-icon-squircle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background: #d25c3a;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    border-radius: 4px;
  }

  .app-window-name {
    font-size: 12px;
    font-weight: 700;
    color: #f4f4f5;
  }

  .doc-badge {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    background: #272a30;
    border-radius: 4px;
    font-size: 11px;
    color: #a1a1aa;
    font-family: "JetBrains Mono", monospace;
  }

  .titlebar-center {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pill-select {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    background: #282b31;
    border: 1px solid #363a43;
    border-radius: 5px;
    font-size: 11.5px;
    font-weight: 500;
    color: #d4d4d8;
    cursor: default;
  }

  .pill-select.is-theme {
    position: relative;
    cursor: pointer;
  }

  .pill-select.is-theme:hover {
    background: #32363e;
    border-color: #434854;
  }

  .titlebar-theme-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 140px;
    background: #18191d;
    border: 1px solid #32353e;
    border-radius: 8px;
    padding: 5px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    z-index: 100;
    display: none;
    flex-direction: column;
    gap: 2px;
  }

  .titlebar-theme-menu.is-open {
    display: flex;
  }

  .titlebar-theme-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 11.5px;
    color: #e4e4e7;
    cursor: pointer;
    transition: background 0.12s ease;
  }

  .titlebar-theme-item:hover {
    background: #282b34;
    color: #ffffff;
  }

  .swatch-square {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .arrow {
    font-size: 9px;
    color: #71717a;
    margin-left: 2px;
  }

  .titlebar-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .theme-icon-toggle {
    display: flex;
    gap: 4px;
    padding: 2px 6px;
    background: #272a30;
    border-radius: 4px;
    font-size: 10px;
    color: #71717a;
  }

  .win-btn {
    padding: 4px 10px;
    border-radius: 5px;
    font-size: 11.5px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: default;
  }

  .win-btn-subtle {
    background: #272a30;
    border: 1px solid #363a43;
    color: #d4d4d8;
  }

  .win-btn-export {
    background: #d25c3a;
    border: 1px solid #e06947;
    color: #fff;
    font-weight: 600;
  }

  /* Subbars Row */
  .app-subbars {
    display: grid;
    grid-template-columns: 48% 52%;
    border-bottom: 1px solid #24272d;
    background: #18191c;
    font-size: 11px;
    user-select: none;
  }

  .editor-subbar, .preview-subbar {
    display: flex;
    align-items: center;
    padding: 6px 14px;
    gap: 12px;
    white-space: nowrap;
    overflow: hidden;
  }

  .editor-subbar {
    border-right: 1px solid #24272d;
    justify-content: space-between;
  }

  .subbar-left-group {
    display: flex;
    align-items: center;
    gap: 12px;
    overflow: hidden;
  }

  .preview-subbar {
    justify-content: space-between;
  }

  .subbar-label {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #71717a;
    font-weight: 600;
  }

  .editor-formatting-tools {
    display: flex;
    gap: 8px;
    color: #a1a1aa;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
  }

  .editor-tools-right {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #71717a;
    flex-shrink: 0;
  }

  .active-badge {
    color: #d25c3a;
    font-weight: 700;
  }

  .badge-issues {
    padding: 1px 6px;
    background: #23272e;
    color: #10b981;
    border-radius: 4px;
    font-size: 9.5px;
  }

  .preview-page-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pg-arrow {
    background: #24272d;
    border: 1px solid #333740;
    color: #e4e4e7;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    cursor: pointer;
  }

  .pg-arrow:hover {
    background: #2f343d;
  }

  .pg-status {
    font-size: 11px;
    font-weight: 600;
    color: #d4d4d8;
    min-width: 32px;
    text-align: center;
  }

  .page-view-tabs {
    display: flex;
    margin-left: 8px;
    background: #24272d;
    border-radius: 5px;
    padding: 2px;
    gap: 2px;
  }

  .view-tab {
    padding: 2px 8px;
    font-size: 10.5px;
    color: #a1a1aa;
    background: transparent;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .view-tab.is-active {
    background: #363b45;
    color: #fff;
    font-weight: 600;
  }

  .preview-status-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .zoom-level {
    color: #71717a;
  }

  .preview-meta {
    color: #a1a1aa;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
  }

  /* App Main Split */
  .app-body {
    display: grid;
    grid-template-columns: 48% 52%;
    height: 600px;
    background: #111214;
  }

  /* CodeMirror Editor Pane */
  .editor-pane {
    display: flex;
    position: relative;
    border-right: 1px solid #24272d;
    background: #141518;
    overflow: hidden;
  }

  .cm-gutter {
    width: 44px;
    flex-shrink: 0;
    background: #16171b;
    border-right: 1px solid #22242a;
    padding: 12px 0;
    text-align: right;
    user-select: none;
  }

  .cm-line-numbers {
    color: #52525b;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    line-height: 19px;
    padding-right: 10px;
  }

  .cm-content {
    flex: 1;
    padding: 12px 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    line-height: 19px;
    overflow-y: auto;
    color: #d4d4d8;
  }

  .cm-line {
    white-space: pre;
  }

  .tok-hr { color: #52525b; font-weight: 700; }
  .tok-prop { color: #f472b6; }
  .tok-string { color: #38bdf8; }
  .tok-h2 { color: #e56c47; font-weight: 700; }
  .tok-h3 { color: #fb923c; font-weight: 700; }
  .tok-math { color: #a3e635; font-weight: 500; }
  .tok-quote { color: #94a3b8; font-style: italic; }
  .tok-table { color: #c084fc; }

  .editor-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 24px;
    background: #1a1b20;
    border-top: 1px solid #252830;
    display: flex;
    align-items: center;
    padding: 0 10px;
    gap: 12px;
    font-size: 10px;
    color: #71717a;
  }

  .editor-bottom-bar .tab.is-active {
    color: #e4e4e7;
    font-weight: 600;
  }

  .editor-meta {
    margin-left: auto;
  }

  /* Preview Stage: True A4 Sheet presentation */
  .preview-stage {
    background: #090a0c;
    padding: 28px 24px;
    overflow-y: auto;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /* Physical Document Page Sheet (A4 aspect ratio, 210mm x 297mm) */
  .doc-page-sheet {
    width: 100%;
    max-width: 440px;
    min-height: 540px;
    background: #ffffff;
    color: #111111;
    border-radius: 3px;
    padding: 24px 28px;
    box-shadow: 
      0 2px 5px rgba(0,0,0,0.25),
      0 12px 30px rgba(0,0,0,0.45);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s var(--ease-out);
    font-family: var(--font-body, -apple-system, sans-serif);
  }

  /* Cover Sheet View */
  .doc-cover-sheet {
    width: 100%;
    max-width: 440px;
    min-height: 540px;
    border-radius: 3px;
    padding: 32px 28px;
    box-shadow: 
      0 2px 5px rgba(0,0,0,0.25),
      0 12px 30px rgba(0,0,0,0.45);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    position: relative;
    overflow: hidden;
    transition: all 0.25s var(--ease-out);
  }

  .cover-kicker-line {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cover-kicker, #d4ff2b);
    margin-top: 24px;
    margin-bottom: 12px;
    font-family: "JetBrains Mono", monospace;
  }

  .cover-title {
    font-size: 24px;
    line-height: 1.1;
    font-weight: 700;
    color: var(--cover-title, #ffffff);
    margin-bottom: 8px;
    font-family: var(--font-display, "Space Grotesk", sans-serif);
  }

  .cover-client-line {
    font-size: 11px;
    color: var(--cover-client, #949494);
    margin-bottom: auto;
  }

  .cover-rule-divider {
    width: 100%;
    height: 1px;
    background: var(--cover-rule, rgba(255,255,255,0.15));
    margin: 24px 0 16px;
  }

  .cover-grid-details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }

  .cov-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cov-lbl {
    font-size: 7.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cover-dt, #71717a);
    font-family: "JetBrains Mono", monospace;
  }

  .cov-val {
    font-size: 10px;
    color: var(--cover-dd, #ffffff);
  }

  .cover-accent-rings {
    position: absolute;
    bottom: -30px;
    right: -30px;
    width: 140px;
    height: 140px;
    pointer-events: none;
  }

  .cover-accent-rings span {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--cover-ring, rgba(212, 255, 43, 0.3));
  }

  .ring-1 { inset: 0; }
  .ring-2 { inset: 20px; }
  .ring-3 { inset: 40px; }

  /* Body Page Styles */
  .sheet-running-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e4e4e7;
    padding-bottom: 8px;
    margin-bottom: 16px;
    font-size: 7.5px;
    font-family: "JetBrains Mono", monospace;
    font-weight: 600;
    color: #71717a;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sheet-body-content {
    flex: 1;
  }

  .sheet-h2 {
    font-size: 15px;
    line-height: 1.25;
    margin-bottom: 8px;
    font-weight: 700;
    color: var(--heading, #000000);
    font-family: var(--font-display, "Space Grotesk", sans-serif);
    border-left: 3.5px solid var(--accent-bar, #d4ff2b);
    padding-left: 8px;
    transition: all 0.3s ease;
  }

  .sheet-lead {
    font-size: 9.5px;
    line-height: 1.5;
    color: #27272a;
    margin-bottom: 10px;
  }

  .sheet-p {
    font-size: 9.5px;
    line-height: 1.5;
    color: #27272a;
    margin: 8px 0;
  }

  .sheet-math-inline {
    display: inline-block;
    vertical-align: middle;
  }

  /* Rendered Equation Cards */
  .sheet-equation-card {
    position: relative;
    background: var(--eq-bg, #fafafa);
    border: 1px solid var(--eq-border, #f0f0f0);
    border-left: 3.5px solid var(--accent-bar, #d4ff2b);
    border-radius: 4px;
    padding: 8px 12px;
    margin: 8px 0;
    text-align: center;
    transition: all 0.3s ease;
  }

  .sheet-equation-math {
    font-size: 10px;
    color: var(--heading, #000);
  }

  .sheet-eq-num {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 8px;
    font-family: "JetBrains Mono", monospace;
    color: #71717a;
  }

  .sheet-blockquote {
    border-left: 3.5px solid var(--quote-border, #d4ff2b);
    background: var(--quote-bg, #f4f7ea);
    color: var(--quote-fg, #111111);
    padding: 7px 10px;
    margin: 10px 0;
    border-radius: 0 4px 4px 0;
    font-size: 9px;
    line-height: 1.45;
    transition: all 0.3s ease;
  }

  .sheet-blockquote p {
    margin: 0;
  }

  .sheet-table-section {
    margin-top: 10px;
  }

  .sheet-table-kicker {
    font-size: 7.5px;
    font-family: "JetBrains Mono", monospace;
    font-weight: 700;
    color: var(--subheading, #333);
    margin-bottom: 4px;
    transition: all 0.3s ease;
  }

  .sheet-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 8.5px;
  }

  .sheet-table th {
    text-align: left;
    padding: 5px 6px;
    background: var(--th-bg, transparent);
    border-bottom: 2px solid var(--th-border, #000);
    font-size: 7.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--th-fg, #000);
    transition: all 0.3s ease;
  }

  .sheet-table th:last-child,
  .sheet-table td:last-child {
    text-align: right;
  }

  .sheet-table td {
    padding: 4px 6px;
    border-bottom: 1px solid #e4e4e7;
    color: #27272a;
  }

  .sheet-running-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.5px solid var(--header-rule, #e4e4e7);
    padding-bottom: 8px;
    margin-bottom: 16px;
    font-size: 7.5px;
    font-family: "JetBrains Mono", monospace;
    font-weight: 600;
    color: var(--header-fg, #71717a);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .sheet-running-footer {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #e4e4e7;
    padding-top: 8px;
    margin-top: 14px;
    font-size: 7.5px;
    font-family: "JetBrains Mono", monospace;
    color: #71717a;
    transition: all 0.3s ease;
  }

  /* ==========================================================================
     THEME DEFINITIONS FOR ACTIVE PAGE & ACTIVE COVER
     ========================================================================== */

  /* 1. VOLTAGE */
  .doc-page-sheet.theme-voltage {
    --heading: #000000;
    --subheading: #1a1a1a;
    --font-display: "Space Grotesk", sans-serif;
    --accent-bar: #d4ff2b;
    --quote-border: #d4ff2b;
    --quote-bg: #f5f8ea;
    --quote-fg: #000000;
    --th-border: #000000;
    --th-bg: #f4fcce;
    --th-fg: #000000;
    --header-rule: #000000;
    --header-fg: #000000;
    --eq-bg: #fafdf2;
    --eq-border: #e2f4a4;
  }
  .doc-cover-sheet.theme-voltage {
    background: #000000;
    --cover-title: #ffffff;
    --cover-accent: #d4ff2b;
    --cover-kicker: #d4ff2b;
    --cover-client: #949494;
    --cover-rule: rgba(255,255,255,0.15);
    --cover-dt: #71717a;
    --cover-dd: #ffffff;
    --cover-ring: rgba(212, 255, 43, 0.35);
  }

  /* 2. EDITORIAL */
  .doc-page-sheet.theme-editorial {
    --heading: #18342e;
    --subheading: #b84f32;
    --font-display: Georgia, "Times New Roman", serif;
    --accent-bar: #e56c47;
    --quote-border: #e56c47;
    --quote-bg: #fcf5f1;
    --quote-fg: #18342e;
    --th-border: #18342e;
    --th-bg: #eef4f1;
    --th-fg: #18342e;
    --header-rule: #e56c47;
    --header-fg: #18342e;
    --eq-bg: #fdfaf6;
    --eq-border: #ebdcd3;
  }
  .doc-cover-sheet.theme-editorial {
    background: #172d29;
    --cover-title: #fffaf1;
    --cover-accent: #e56c47;
    --cover-kicker: #e56c47;
    --cover-client: #c7d2cd;
    --cover-rule: rgba(218, 230, 225, 0.28);
    --cover-dt: #8fa59d;
    --cover-dd: #eef2ee;
    --cover-ring: rgba(229, 108, 71, 0.4);
  }

  /* 3. SLATE */
  .doc-page-sheet.theme-slate {
    --heading: #0f172a;
    --subheading: #0369a1;
    --font-display: Inter, sans-serif;
    --accent-bar: #38bdf8;
    --quote-border: #38bdf8;
    --quote-bg: #f0f9ff;
    --quote-fg: #0f172a;
    --th-border: #0f172a;
    --th-bg: #e0f2fe;
    --th-fg: #0f172a;
    --header-rule: #38bdf8;
    --header-fg: #0f172a;
    --eq-bg: #f8fafc;
    --eq-border: #bae6fd;
  }
  .doc-cover-sheet.theme-slate {
    background: #0f172a;
    --cover-title: #f8fafc;
    --cover-accent: #38bdf8;
    --cover-kicker: #38bdf8;
    --cover-client: #94a3b8;
    --cover-rule: rgba(148, 163, 184, 0.35);
    --cover-dt: #64748b;
    --cover-dd: #e2e8f0;
    --cover-ring: rgba(56, 189, 248, 0.35);
  }

  /* 4. SCIENTIFIC */
  .doc-page-sheet.theme-scientific {
    --heading: #172b3a;
    --subheading: #27465b;
    --font-display: "Times New Roman", Georgia, serif;
    --accent-bar: #2563eb;
    --quote-border: #47657a;
    --quote-bg: #f5f8f9;
    --quote-fg: #202a32;
    --th-border: #47657a;
    --th-bg: #f1f5f9;
    --th-fg: #172b3a;
    --header-rule: #94a3b8;
    --header-fg: #475569;
    --eq-bg: #ffffff;
    --eq-border: #cbd5e1;
  }
  .doc-cover-sheet.theme-scientific {
    background: #ffffff;
    border: 1px solid #e4e4e7;
    --cover-title: #172b3a;
    --cover-accent: #47657a;
    --cover-kicker: #47657a;
    --cover-client: #52616b;
    --cover-rule: #9aabb6;
    --cover-dt: #61717b;
    --cover-dd: #202a32;
    --cover-ring: rgba(71, 101, 122, 0.25);
  }

  /* 5. CONTRAST */
  .doc-page-sheet.theme-contrast {
    --heading: #000000;
    --subheading: #000000;
    --font-display: Inter, sans-serif;
    --accent-bar: #000000;
    --quote-border: #000000;
    --quote-bg: #f5f5f5;
    --quote-fg: #000000;
    --th-border: #000000;
    --th-bg: #000000;
    --th-fg: #ffffff;
    --header-rule: #000000;
    --header-fg: #000000;
    --eq-bg: #ffffff;
    --eq-border: #000000;
  }
  .doc-cover-sheet.theme-contrast {
    background: #000000;
    --cover-title: #ffffff;
    --cover-accent: #ffffff;
    --cover-kicker: #a1a1a1;
    --cover-client: #8f8f8f;
    --cover-rule: rgba(255, 255, 255, 0.22);
    --cover-dt: #6f6f6f;
    --cover-dd: #ededed;
    --cover-ring: rgba(255, 255, 255, 0.2);
  }

  /* 6. GRAPHITE */
  .doc-page-sheet.theme-graphite {
    --heading: #09090b;
    --subheading: #4d7c0f;
    --font-display: Inter, sans-serif;
    --accent-bar: #a3e635;
    --quote-border: #a3e635;
    --quote-bg: #f4fce3;
    --quote-fg: #18181b;
    --th-border: #18181b;
    --th-bg: #ecfccb;
    --th-fg: #18181b;
    --header-rule: #a3e635;
    --header-fg: #18181b;
    --eq-bg: #fcfcf9;
    --eq-border: #d9f99d;
  }
  .doc-cover-sheet.theme-graphite {
    background: #101113;
    --cover-title: #ffffff;
    --cover-accent: #a3e635;
    --cover-kicker: #a3e635;
    --cover-client: #a1a1aa;
    --cover-rule: rgba(63, 63, 70, 0.6);
    --cover-dt: #71717a;
    --cover-dd: #f4f4f5;
    --cover-ring: rgba(163, 230, 53, 0.35);
  }

  /* 7. NOCTURNE */
  .doc-page-sheet.theme-nocturne {
    --heading: #2e1065;
    --subheading: #7c3aed;
    --font-display: "Space Grotesk", sans-serif;
    --accent-bar: #ff79c6;
    --quote-border: #ff79c6;
    --quote-bg: #fdf2f8;
    --quote-fg: #2e1065;
    --th-border: #7c3aed;
    --th-bg: #f3e8ff;
    --th-fg: #2e1065;
    --header-rule: #ff79c6;
    --header-fg: #7c3aed;
    --eq-bg: #faf5ff;
    --eq-border: #fbcfe8;
  }
  .doc-cover-sheet.theme-nocturne {
    background: #282a36;
    --cover-title: #f8f8f2;
    --cover-accent: #ff79c6;
    --cover-kicker: #8be9fd;
    --cover-client: #a9b1d6;
    --cover-rule: rgba(189, 147, 249, 0.4);
    --cover-dt: #6272a4;
    --cover-dd: #f8f8f2;
    --cover-ring: rgba(255, 121, 198, 0.35);
  }

  /* ==========================================================================
     SECTION STYLES (Clean, minimal, compact typography)
     ========================================================================== */
  .section {
    padding: 5rem 0;
  }

  .section-head {
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 700;
    color: var(--text);
    margin: 0.4rem 0 0.8rem;
  }

  .section-desc {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-2);
  }

  .section-desc code {
    background: rgba(0,0,0,0.05);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }

  /* AI Workflow Bridge Section (Open layout, no cards, clean SVGs) */
  .ai-bridge-section {
    padding: 3.5rem 0 3rem;
  }

  .ai-bridge-header {
    max-width: 820px;
    margin-bottom: 2.5rem;
  }

  .ai-bridge-title {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--text);
    margin: 0.4rem 0 0.9rem;
  }

  .ai-bridge-lede {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .ai-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .ai-feature-item {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .ai-feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--accent);
    flex-shrink: 0;
    transition: all 0.2s var(--ease-out);
  }

  .ai-feature-item:hover .ai-feature-icon {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px var(--accent-light, rgba(0, 0, 0, 0.04));
  }

  .ai-feature-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ai-feature-heading {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0;
  }

  .ai-feature-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-2);
    margin: 0;
  }

  @media (max-width: 820px) {
    .ai-features-grid {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
  }

  /* Interactive Themes Showcase */
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 1.5rem;
  }

  /* Themes Status Row (Clean inline status, not a card) */
  .themes-status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.2rem 0;
    background: transparent;
    border: none;
    font-size: 0.88rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .theme-status-text {
    color: var(--text-2);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .theme-status-text strong {
    color: var(--accent);
    font-weight: 700;
  }

  .btn-reset-theme {
    background: transparent;
    border: none;
    color: var(--text-2);
    font-size: 0.84rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 2px 4px;
    transition: color 0.15s ease;
  }

  .btn-reset-theme:hover {
    color: var(--accent);
  }

  .theme-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 18px;
    text-align: left;
    cursor: pointer;
    transition: transform 0.2s var(--spring), border-color 0.2s ease, box-shadow 0.2s ease, background 0.4s ease;
  }

  .theme-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 4px 16px var(--accent-light, rgba(0,0,0,0.06));
  }

  .theme-card.is-active {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent), 0 6px 20px var(--accent-light, rgba(210, 92, 58, 0.16));
  }

  .theme-card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .theme-swatch-chip {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid transparent;
  }

  .theme-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  .theme-check-radio {
    margin-left: auto;
    font-size: 11px;
    font-weight: 700;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .theme-card.is-active .theme-check-radio {
    opacity: 1;
  }

  .theme-fonts {
    font-size: 0.78rem;
    font-family: "JetBrains Mono", monospace;
    color: var(--text-faint);
    margin-bottom: 6px;
  }

  .theme-desc {
    font-size: 0.88rem;
    color: var(--text-2);
    line-height: 1.45;
  }

  /* LaTeX Math Showcase Box */
  .latex-showcase-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  }

  @media (max-width: 768px) {
    .latex-showcase-box {
      grid-template-columns: 1fr;
    }
  }

  .latex-pane-code {
    background: #141518;
    color: #e4e4e7;
    padding: 24px;
    border-right: 1px solid #22242a;
    display: flex;
    flex-direction: column;
  }

  .pane-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a1a1aa;
    margin-bottom: 14px;
  }

  .latex-pane-code pre {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
    font-size: 0.88rem;
    line-height: 1.5;
    color: #a3e635;
    font-family: "JetBrains Mono", monospace;
  }

  .latex-pane-render {
    background: #ffffff;
    color: #09090b;
    padding: 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background-color 0.3s ease;
  }

  .latex-pane-render .pane-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ba4e31;
    margin-bottom: 14px;
    transition: color 0.3s ease;
  }

  /* High-contrast theme-specific colors for pane-tag on white paper */
  html[data-theme="voltage"] .latex-pane-render .pane-tag { color: #4d6600; }
  html[data-theme="editorial"] .latex-pane-render .pane-tag { color: #ba4e31; }
  html[data-theme="slate"] .latex-pane-render .pane-tag { color: #0284c7; }
  html[data-theme="scientific"] .latex-pane-render .pane-tag { color: #1d4ed8; }
  html[data-theme="contrast"] .latex-pane-render .pane-tag { color: #09090b; }
  html[data-theme="graphite"] .latex-pane-render .pane-tag { color: #3f6212; }
  html[data-theme="nocturne"] .latex-pane-render .pane-tag { color: #86198f; }

  .latex-rendered-math {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
