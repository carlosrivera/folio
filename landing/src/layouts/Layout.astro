---
interface Props {
  title?: string
  description?: string
}

const {
  title = "Folio — macOS Markdown Document Editor & Paginated Publishing",
  description = "A macOS-first Markdown document editor with live A4 paginated preview, proposal templates, LaTeX math, Mermaid diagrams, and pixel-perfect PDF export."
} = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#f5f2e9" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="markdown, pdf publisher, macos app, paged media, katex, latex, proposal, statement of work, electronic document, folio" />
    <link rel="canonical" href="https://carlosrivera.github.io/folio/" />
    
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/icon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/icon.png`} />
    <link rel="apple-touch-icon" href={`${base}/icon.png`} />
    
    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Folio" />
    <meta property="og:url" content="https://carlosrivera.github.io/folio/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://carlosrivera.github.io/folio/og.png" />
    <meta property="og:image:secure_url" content="https://carlosrivera.github.io/folio/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Folio — Plain Markdown. Boardroom-ready pages." />
    
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://carlosrivera.github.io/folio/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://carlosrivera.github.io/folio/og.png" />
    <meta name="twitter:image:alt" content="Folio — Plain Markdown. Boardroom-ready pages." />
    
    <!-- Fonts & Math -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
    
    <!-- Analytics -->
    <script defer src="https://umami-production-f25f.up.railway.app/script.js" data-website-id="4d83835a-a442-46fe-8f1c-cc2e0da0b3a7"></script>
  </head>
  <body>
    <div class="glow" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f2e9;
    --surface: #fdfcf9;
    --border: #e3ded2;
    --border-subtle: #ece6da;
    --text: #1a1614;
    --text-2: #6c635b;
    --text-faint: #9c9187;
    --accent: #d25c3a;
    --accent-hover: #df6845;
    --accent-light: #f7ede8;
    --accent-fg: #ffffff;
    --healthy: #1e9a4b;
    --spring: cubic-bezier(0.2, 1.3, 0.35, 1);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --gutter: clamp(18px, 5vw, 64px);
    --glow-1: rgba(210, 92, 58, 0.05);
    --glow-2: rgba(244, 197, 61, 0.04);
    --nav-bg: rgba(245, 242, 233, 0.88);
    --card-bg: #ffffff;
    --card-border: var(--border);
    color-scheme: light;
  }

  /* 1. VOLTAGE (Pitch Black & Acid Neon Lime) */
  html[data-theme="voltage"] {
    --bg: #090a0f;
    --surface: #121319;
    --border: #232530;
    --border-subtle: #1a1b24;
    --text: #f4f4f5;
    --text-2: #a1a1aa;
    --text-faint: #71717a;
    --accent: #d4ff2b;
    --accent-hover: #e0ff54;
    --accent-light: rgba(212, 255, 43, 0.12);
    --accent-fg: #000000;
    --nav-bg: rgba(9, 10, 15, 0.88);
    --card-bg: #121319;
    --card-border: #232530;
    --glow-1: rgba(212, 255, 43, 0.09);
    --glow-2: rgba(212, 255, 43, 0.03);
    color-scheme: dark;
  }

  /* 2. EDITORIAL (British Racing Green & Terracotta) */
  html[data-theme="editorial"] {
    --bg: #11201c;
    --surface: #172c27;
    --border: #27453d;
    --border-subtle: #1e3630;
    --text: #fbf8f0;
    --text-2: #c4d4ce;
    --text-faint: #8fa69e;
    --accent: #e56c47;
    --accent-hover: #f07b57;
    --accent-light: rgba(229, 108, 71, 0.15);
    --accent-fg: #ffffff;
    --nav-bg: rgba(17, 32, 28, 0.88);
    --card-bg: #172c27;
    --card-border: #27453d;
    --glow-1: rgba(229, 108, 71, 0.1);
    --glow-2: rgba(23, 44, 39, 0.4);
    color-scheme: dark;
  }

  /* 3. SLATE (Midnight Executive Navy & Sky Blue) */
  html[data-theme="slate"] {
    --bg: #0b1220;
    --surface: #111c30;
    --border: #1e3152;
    --border-subtle: #16243d;
    --text: #f8fafc;
    --text-2: #94a3b8;
    --text-faint: #64748b;
    --accent: #38bdf8;
    --accent-hover: #60a5fa;
    --accent-light: rgba(56, 189, 248, 0.15);
    --accent-fg: #071324;
    --nav-bg: rgba(11, 18, 32, 0.88);
    --card-bg: #111c30;
    --card-border: #1e3152;
    --glow-1: rgba(56, 189, 248, 0.09);
    --glow-2: rgba(30, 49, 82, 0.3);
    color-scheme: dark;
  }

  /* 4. SCIENTIFIC (Clean Academic Ivory Paper & Steel Navy) */
  html[data-theme="scientific"] {
    --bg: #f8fafc;
    --surface: #ffffff;
    --border: #e2e8f0;
    --border-subtle: #cbd5e1;
    --text: #0f172a;
    --text-2: #475569;
    --text-faint: #64748b;
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
    --accent-light: rgba(37, 99, 235, 0.1);
    --accent-fg: #ffffff;
    --nav-bg: rgba(248, 250, 252, 0.88);
    --card-bg: #ffffff;
    --card-border: #e2e8f0;
    --glow-1: rgba(37, 99, 235, 0.06);
    --glow-2: rgba(71, 101, 122, 0.05);
    color-scheme: light;
  }

  /* 5. CONTRAST (Stark High-Contrast Brutalist B&W) */
  html[data-theme="contrast"] {
    --bg: #000000;
    --surface: #0e0e11;
    --border: #2e2e33;
    --border-subtle: #1f1f24;
    --text: #ffffff;
    --text-2: #d4d4d8;
    --text-faint: #888888;
    --accent: #ffffff;
    --accent-hover: #e5e5e5;
    --accent-light: rgba(255, 255, 255, 0.15);
    --accent-fg: #000000;
    --nav-bg: rgba(0, 0, 0, 0.88);
    --card-bg: #0e0e11;
    --card-border: #2e2e33;
    --glow-1: rgba(255, 255, 255, 0.04);
    --glow-2: rgba(255, 255, 255, 0.02);
    color-scheme: dark;
  }

  /* 6. GRAPHITE (Engineering Charcoal & Draft Lime) */
  html[data-theme="graphite"] {
    --bg: #101114;
    --surface: #18191e;
    --border: #2a2c35;
    --border-subtle: #202229;
    --text: #f3f4f6;
    --text-2: #9ca3af;
    --text-faint: #6b7280;
    --accent: #a3e635;
    --accent-hover: #bef264;
    --accent-light: rgba(163, 230, 53, 0.14);
    --accent-fg: #0a0b0d;
    --nav-bg: rgba(16, 17, 20, 0.88);
    --card-bg: #18191e;
    --card-border: #2a2c35;
    --glow-1: rgba(163, 230, 53, 0.08);
    --glow-2: rgba(42, 44, 53, 0.3);
    color-scheme: dark;
  }

  /* 7. NOCTURNE (Cyberpunk Midnight Plum & Neon Pink) */
  html[data-theme="nocturne"] {
    --bg: #171224;
    --surface: #201933;
    --border: #382c57;
    --border-subtle: #2b2243;
    --text: #f8f8f2;
    --text-2: #c4b5fd;
    --text-faint: #7c6f9e;
    --accent: #ff79c6;
    --accent-hover: #ff94d2;
    --accent-light: rgba(255, 121, 198, 0.16);
    --accent-fg: #171224;
    --nav-bg: rgba(23, 18, 36, 0.88);
    --card-bg: #201933;
    --card-border: #382c57;
    --glow-1: rgba(255, 121, 198, 0.1);
    --glow-2: rgba(196, 181, 253, 0.05);
    color-scheme: dark;
  }

  html, body {
    transition: background-color 0.4s ease, color 0.4s ease;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: clip;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", system-ui, Segoe UI, Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.55;
    overflow-x: clip;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  code, pre {
    font-family: "JetBrains Mono", Menlo, monospace;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .glow {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(45vmax 45vmax at 50% 18%, var(--glow-1, rgba(210, 92, 58, 0.05)), transparent 70%),
      radial-gradient(40vmax 40vmax at 8% 70%, var(--glow-2, rgba(244, 197, 61, 0.04)), transparent 70%),
      var(--bg);
    transition: background 0.4s ease;
  }

  .container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
</style>
